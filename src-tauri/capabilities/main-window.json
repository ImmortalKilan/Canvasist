{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the bundled main window. Remote pages (such as a school's Canvas login page) are never granted any capability.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-set-language",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-app-info",
    "allow-search-schools",
    "allow-check-canvas-url",
    "allow-start-canvas-login",
    "allow-cancel-canvas-login",
    "allow-get-auth-status",
    "allow-sign-out",
    "allow-get-canvas-snapshot",
    "allow-refresh-canvas",
    "allow-open-external",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
